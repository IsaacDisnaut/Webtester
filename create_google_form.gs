/**
 * สคริปต์สร้าง Google Form จากแบบสอบถามหุ่นยนต์ควบคุมระยะไกล (question.md)
 *
 * วิธีใช้:
 * 1. เปิด https://script.google.com -> โปรเจกต์ใหม่ (New project)
 * 2. ลบโค้ดเดิมทั้งหมด แล้ววางไฟล์นี้ทั้งหมดแทน
 * 3. กดปุ่ม Run (เลือกฟังก์ชัน createSurveyForm) แล้วกด Authorize ตามที่ขอ
 * 4. ดู URL ของฟอร์มได้จากหน้าต่าง Log (Ctrl+Enter หรือเมนู View > Logs)
 */
function createSurveyForm() {
  var form = FormApp.create('แบบสอบถาม หุ่นยนต์ควบคุมระยะไกล (Telepresence/Avatar Robot) เพื่อการทำงานของผู้พิการ');

  form.setDescription(
    'ศึกษาความคิดเห็นหลังจากได้ทดลองใช้งานหุ่นยนต์ที่มนุษย์ควบคุมจากระยะไกลผ่านเว็บ ' +
    '(ผู้ควบคุม/operator อยู่หน้าจอคอมพิวเตอร์ ควบคุมหุ่นยนต์ Avatar เพื่อสื่อสาร/ปฏิบัติงานผ่านระบบ Video call) ' +
    'โดยเฉพาะในมุมมองของการนำไปใช้เป็นช่องทางการดำรงชีวิตและการประกอบอาชีพสำหรับผู้พิการหรือผู้มีข้อจำกัดทางร่างกาย\n\n' +
    'คำชี้แจง: แบบสอบถามนี้ใช้เวลาประมาณ 3-5 นาที ข้อมูลที่ท่านให้จะถูกเก็บเป็นความลับและใช้เพื่อการวิจัยเท่านั้น ' +
    'ไม่มีคำตอบใดถูกหรือผิด กรุณาตอบหลังจากได้ทดลองใช้งานหรือชมการสาธิตระบบแล้ว'
  );

  form.setCollectEmail(false);
  form.setProgressBar(true);

  // ส่วนที่ 1
  form.addPageBreakItem().setTitle('ส่วนที่ 1: ข้อมูลผู้ตอบแบบสอบถาม');

  form.addMultipleChoiceItem()
    .setTitle('1. ท่านมีความพิการหรือข้อจำกัดทางร่างกาย/การเคลื่อนไหวด้านใด')
    .setChoiceValues([
      'ไม่มี',
      'ทางการเคลื่อนไหว/ร่างกาย (เช่น ใช้วีลแชร์, แขน-ขาอ่อนแรง)',
      'ทางการมองเห็น',
      'ทางการได้ยิน/การสื่อสาร',
      'ประเภทอื่น (โปรดระบุ)',
      'ไม่ประสงค์ระบุ'
    ])
    .showOtherOption(false)
    .setRequired(true);

  // ส่วนที่ 2
  form.addPageBreakItem().setTitle('ส่วนที่ 2: ประโยชน์และการนำไปใช้ในการดำรงชีวิต/การประกอบอาชีพ');

  form.addCheckboxItem()
    .setTitle('2. หลังจากทดลองใช้งานแล้ว ท่านคิดว่าระบบนี้มีประโยชน์ต่อการดำรงชีวิตของท่านอย่างไรบ้าง')
    .setHelpText('เลือกได้มากกว่า 1 ข้อ')
    .setChoiceValues([
      'ช่วยให้สามารถทำงาน/หารายได้จากที่บ้านได้',
      'ช่วยให้ติดต่อสื่อสารกับผู้อื่นได้สะดวกขึ้น',
      'ช่วยเพิ่มความมั่นใจในการทำกิจกรรมที่เคยเป็นอุปสรรค',
      'ช่วยให้เข้าถึงสถานที่/บริการที่เคยเข้าถึงยาก',
      'ไม่คิดว่ามีประโยชน์ชัดเจน'
    ])
    .showOtherOption(true)
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('3. หากนำระบบนี้ไปใช้ช่วยเหลือในการประกอบอาชีพ ท่านคิดว่าเหมาะกับอาชีพ/งานลักษณะใดมากที่สุด')
    .setHelpText('เลือกได้มากกว่า 1 ข้อ')
    .setChoiceValues([
      'งานบริการลูกค้า/ต้อนรับ (เช่น ธนาคาร โรงพยาบาล ห้างสรรพสินค้า)',
      'งาน call center/ศูนย์บริการลูกค้า',
      'การศึกษา/ติวเตอร์ทางไกล',
      'งานประชาสัมพันธ์/แนะนำสถานที่',
      'งานตรวจสอบ/สำรวจพื้นที่ หรือรักษาความปลอดภัย',
      'งานประชุม/ทำงานร่วมกับทีมจากระยะไกล'
    ])
    .showOtherOption(true)
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('3.1 แนวทางที่ควรนำไปใช้กับอาชีพที่เลือก')
    .setRequired(false);

  form.addMultipleChoiceItem()
    .setTitle('4. สิ่งที่ท่านประทับใจมากที่สุดจากการทดลองใช้งานคืออะไร')
    .setChoiceValues([
      'ความง่ายในการเริ่มต้นใช้งาน',
      'คุณภาพภาพและเสียงระหว่างการสนทนา',
      'ความลื่นไหลในการควบคุมหุ่นยนต์',
      'ความสามารถในการสื่อสาร/ถ่ายทอดอารมณ์ผ่านหุ่นยนต์',
      'โอกาสในการทำงาน/สร้างรายได้ที่เพิ่มขึ้น'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // ส่วนที่ 3
  form.addPageBreakItem().setTitle('ส่วนที่ 3: ข้อเสนอแนะเพิ่มเติม');

  form.addParagraphTextItem()
    .setTitle('5. ท่านมีข้อเสนอแนะเพิ่มเติมเกี่ยวกับการพัฒนาระบบนี้ หรือการนำไปใช้ช่วยเหลือผู้พิการในการประกอบอาชีพหรือไม่')
    .setRequired(false);

  Logger.log('สร้างฟอร์มสำเร็จ');
  Logger.log('ลิงก์สำหรับแก้ไข (edit): ' + form.getEditUrl());
  Logger.log('ลิงก์สำหรับส่งให้ผู้ตอบ (published): ' + form.getPublishedUrl());
}
